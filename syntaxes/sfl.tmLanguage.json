{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SFL",
  "scopeName": "source.sfl",
  "comment": "Regex-based TextMate grammar. Mirrors the token classification already proven in frontend/src/features/sfl/highlight.ts (block keywords at header position vs. property keys vs. value constants vs. style refs after ':'). Semantic tokens from the language server refine what this regex approximation can't reliably tell apart (e.g. a reference vs. a keyword).",
  "patterns": [
    { "include": "#comments" },
    { "include": "#header-line" },
    { "include": "#block-header-container" },
    { "include": "#block-header-leaf" },
    { "include": "#layout-header" },
    { "include": "#property-key" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#colon-value" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "match": "//.*$",
      "name": "comment.line.double-slash.sfl"
    },
    "header-line": {
      "comment": "The document header: `sfl 1.1`",
      "match": "^\\s*\\b(sfl)\\b\\s+(-?\\d+(?:\\.\\d+)?)",
      "captures": {
        "1": { "name": "keyword.other.header.sfl" },
        "2": { "name": "constant.numeric.version.sfl" }
      }
    },
    "block-header-container": {
      "comment": "Project/Flow/Group/Container — blocks that may contain nested blocks",
      "match": "^\\s*\\b(Project|Flow|Group|Container)\\b\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s*(:)\\s*([A-Za-z_][A-Za-z0-9_]*))?",
      "captures": {
        "1": { "name": "keyword.control.container.sfl" },
        "2": { "name": "entity.name.type.sfl" },
        "3": { "name": "punctuation.separator.colon.sfl" },
        "4": { "name": "entity.other.inherited-class.sfl" }
      }
    },
    "block-header-leaf": {
      "comment": "Entity/Link/Style — leaf blocks",
      "match": "^\\s*\\b(Entity|Link|Style)\\b\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s*(:)\\s*([A-Za-z_][A-Za-z0-9_]*))?",
      "captures": {
        "1": { "name": "storage.type.sfl" },
        "2": { "name": "entity.name.function.sfl" },
        "3": { "name": "punctuation.separator.colon.sfl" },
        "4": { "name": "entity.other.inherited-class.sfl" }
      }
    },
    "layout-header": {
      "match": "^\\s*\\b(layout)\\b",
      "captures": {
        "1": { "name": "keyword.other.layout.sfl" }
      }
    },
    "property-key": {
      "comment": "identifier directly before ':' at the start of a (trimmed) line — a property key",
      "match": "^\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(?=:)",
      "captures": {
        "1": { "name": "variable.other.property.sfl" }
      }
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.sfl",
          "begin": "\"\"\"",
          "end": "\"\"\""
        },
        {
          "name": "string.quoted.double.sfl",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.sfl",
              "match": "\\\\[\"\\\\nt]"
            }
          ]
        }
      ]
    },
    "numbers": {
      "match": "-?\\d+(?:\\.\\d+)?",
      "name": "constant.numeric.sfl"
    },
    "colon-value": {
      "comment": "`: value` on a property line — bare identifier/keyword/path (kind: decision, from: cart.load_cart, top 0.5, ...). Header colons are already consumed by the block-header rules above, so this only fires on property lines.",
      "match": "(:)\\s*([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
      "captures": {
        "1": { "name": "punctuation.separator.colon.sfl" },
        "2": { "name": "constant.language.sfl" }
      }
    },
    "punctuation": {
      "patterns": [
        { "match": "\\{", "name": "punctuation.definition.block.begin.sfl" },
        { "match": "\\}", "name": "punctuation.definition.block.end.sfl" },
        { "match": "\\[", "name": "punctuation.definition.list.begin.sfl" },
        { "match": "\\]", "name": "punctuation.definition.list.end.sfl" },
        { "match": ",", "name": "punctuation.separator.comma.sfl" },
        { "match": "\\.", "name": "punctuation.accessor.sfl" },
        { "match": ":", "name": "punctuation.separator.colon.sfl" }
      ]
    }
  }
}
