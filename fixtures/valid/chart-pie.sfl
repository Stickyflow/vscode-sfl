sfl 1.4

Model board {
  Chart share {
    text: "Market share"
    type: pie

    Axis x { min: 0; max: 1; step: 1 }
    Axis y { min: 0; max: 1; step: 1 }

    Series a { label: "A"; color: "#4e3180"; values: [30] }
    Series b { label: "B"; values: [70] }

    layout {
      position: 0, 0
      size: 300, 200
    }
  }
}
