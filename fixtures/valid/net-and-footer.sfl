sfl 1.4

Model board {
  Entity amp1 {
    kind: component
    text: "Amp 1"
    layout { position: 0, 0; size: 100, 60 }
  }

  Entity amp2 {
    kind: component
    text: "Amp 2"
    layout { position: 300, 0; size: 100, 60 }
  }

  Entity psu {
    kind: component
    text: "PSU"
    layout { position: 600, 0; size: 100, 60 }
  }

  Net vcc {
    members: [amp1, amp2, psu]
    text: "+5V"
  }

  Table costs {
    text: "Costs"

    Columns cols {
      Column item {
        text: "Item"
        width: 160
      }
      Column amount {
        text: "Amount"
        width: 100
      }
    }

    Rows rows {
      Row parts {
        item: "Parts"
        amount: "40"
      }
      Row labour {
        item: "Labour"
        amount: "60"
      }
    }

    Footer total {
      item: "Total"
      amount: "100"
    }

    layout {
      position: 0, 200
      size: 320, 160
    }
  }
}
